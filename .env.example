# Copy to .env (gitignored) before running `docker compose up`.
# Only used by the Docker Compose stack - has nothing to do with the native
# `dotnet run` workflow (which reads its connection string and GitHub token
# from User Secrets, see docs/local-development.md).
SQL_SA_PASSWORD=Sup3rSecret!Dev

# Fine-grained PAT scoped to sancruzblog-content-curation only, with
# "Issues: Read and write" - see docs/decisions/ADR-003-curadoria-via-github-issues.md.
GITHUB_TOKEN=
